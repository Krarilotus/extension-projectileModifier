  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attached_board_radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "attached_interval": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "description": "Enables firing for a siege tower docked to a wall, overriding moving/standing intervals; 0 holds fire. Omission keeps the current moving/standing rate or fallback."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "cow_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "density_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "density_radius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "inaccuracy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 800,
          "description": "Maximum random aim-error radius in whole native coordinate units: 1 = 1/8 tile, 8 = 1 tile. Explicit 0 removes native random error; omission preserves it. Separate spread still applies. Do not combine with inaccuracy_tiles."
        },
        "inaccuracy_tiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Compatibility alias in whole tiles, converted by multiplying by 8. Prefer inaccuracy for native 1/8-tile steps. Do not combine both fields."
        },
        "interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "description": "Optional fallback automatic-fire interval in simulation ticks. Applies only where no state interval overrides it."
        },
        "interval_moving": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "description": "Enables firing while moving; 0 holds fire. If omitted, use interval, or hold fire if neither is set."
        },
        "interval_standing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "description": "Enables firing while stopped, not specifically docked; 0 holds fire. If omitted, use interval, or hold fire if neither is set."
        },
        "preload_poll": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "require_manned": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "boolean"
            }
          ],
          "description": "Engineers currently aboard. Native reload defaults: trebuchet 3, other supported siege engines 2. Independent timer defaults 0. Explicit true means 1; false or 0 allows unmanned fire."
        },
        "shoot_height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "spread": {
          "type": "integer",
          "minimum": 0,
          "maximum": 800,
          "description": "Additional simultaneous-shot spread per axis, in whole native coordinate units: 1 = 1/8 tile, 8 = 1 tile. Zero adds no spread. Independent of inaccuracy."
        },
        "spread_tiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Compatibility alias in whole tiles, converted by multiplying by 8. Prefer spread for native 1/8-tile steps. Do not combine both fields."
        },
        "stagger_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "stagger_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "description": "Requires stagger_max; must not exceed it when staggering is enabled. Checked by the game loader."
        },
        "sync_max_wait": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "description": "Legacy animation wait only; never bypasses a native reload firing frame."
        },
        "wall_min_distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ai_cow_vs_units": {
          "type": "boolean"
        },
        "ai_only": {
          "type": "boolean"
        },
        "attached_ignore_crew": {
          "type": "boolean"
        },
        "attached_stop_when_boarded": {
          "type": "boolean"
        },
        "preload": {
          "type": "boolean"
        },
        "random_targets": {
          "type": "boolean"
        },
        "suppress_default": {
          "type": "boolean",
          "description": "Defaults true with an interval. False combines native and automatic shots only in independent timer mode; it cannot bypass native reload timing. Unchanged cow orders remain available."
        },
        "sync_to_animation": {
          "type": "boolean",
          "description": "Defaults to native firing-frame timing for catapult, trebuchet, mangonel and both ballistas: reload while waiting and never truncate the animation. False selects the independent timer. Other units default false; true uses the legacy bounded animation wait."
        },
        "projectile": {
          "enum": [
            "arrow",
            "arrow_untargeted",
            "ballista_bolt",
            "catapult_rock",
            "cow",
            "crossbow_bolt",
            "crossbow_bolt_untargeted",
            "fire_arrow",
            "fire_arrow_untargeted",
            "fire_ballista_bolt",
            "firethrower_pot",
            "firethrower_pot_untargeted",
            "mangonel_pebble",
            "slinger_stone",
            "slinger_stone_untargeted",
            "trebuchet_rock",
            1,
            2,
            3,
            4,
            7,
            20,
            23,
            24,
            25,
            33,
            34,
            35,
            36,
            37,
            91,
            92
          ]
        },
        "cow_projectile": {
          "enum": [
            "arrow",
            "arrow_untargeted",
            "ballista_bolt",
            "catapult_rock",
            "cow",
            "crossbow_bolt",
            "crossbow_bolt_untargeted",
            "fire_arrow",
            "fire_arrow_untargeted",
            "fire_ballista_bolt",
            "firethrower_pot",
            "firethrower_pot_untargeted",
            "mangonel_pebble",
            "slinger_stone",
            "slinger_stone_untargeted",
            "trebuchet_rock",
            1,
            2,
            3,
            4,
            7,
            20,
            23,
            24,
            25,
            33,
            34,
            35,
            36,
            37,
            91,
            92
          ],
          "description": "Separate replacement for native siege cow ammunition and automatic AI cow shots. Omission preserves cows."
        },
        "targets": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "buildings",
                "cluster",
                "fortifications",
                "siege_towers",
                "units",
                "walls"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "buildings",
                  "cluster",
                  "fortifications",
                  "siege_towers",
                  "units",
                  "walls"
                ]
              },
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true
            }
          ]
        },
        "on_fortification": {
          "$ref": "#/$defs/override"
        }
      },
      "dependentSchemas": {
        "stagger_max": {
          "anyOf": [
            {
              "required": [
                "interval"
              ]
            },
            {
              "required": [
                "interval_moving"
              ]
            },
            {
              "required": [
                "interval_standing"
              ]
            },
            {
              "required": [
                "attached_interval"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "spread",
              "spread_tiles"
            ]
          }
        },
        {
          "not": {
            "required": [
              "inaccuracy",
              "inaccuracy_tiles"
            ]
          }
        }
      ],
      "dependentRequired": {
        "stagger_min": [
          "stagger_max"
        ]
      }
    },
