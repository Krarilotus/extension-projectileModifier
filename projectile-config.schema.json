  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attached_board_radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "attached_interval": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "density_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "density_radius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "inaccuracy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 800
        },
        "inaccuracy_tiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "interval_moving": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "interval_standing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "preload_poll": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "require_manned": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "boolean"
            }
          ]
        },
        "shoot_height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "spread": {
          "type": "integer",
          "minimum": 0,
          "maximum": 800
        },
        "spread_tiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stagger_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "stagger_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "description": "Requires stagger_max; must not exceed it when staggering is enabled. Checked by the game loader."
        },
        "sync_max_wait": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "wall_min_distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ai_cow_vs_units": {
          "type": "boolean"
        },
        "ai_only": {
          "type": "boolean"
        },
        "attached_ignore_crew": {
          "type": "boolean"
        },
        "attached_stop_when_boarded": {
          "type": "boolean"
        },
        "preload": {
          "type": "boolean"
        },
        "random_targets": {
          "type": "boolean"
        },
        "suppress_default": {
          "type": "boolean"
        },
        "sync_to_animation": {
          "type": "boolean"
        },
        "projectile": {
          "enum": [
            "arrow",
            "ballista_bolt",
            "catapult_rock",
            "cow",
            "crossbow_bolt",
            "fire_ballista_bolt",
            "firethrower_pot",
            "firethrower_pot_untargeted",
            "mangonel_pebble",
            "slinger_stone",
            "trebuchet_rock",
            1,
            2,
            3,
            4,
            7,
            20,
            23,
            33,
            35,
            36,
            37
          ]
        },
        "targets": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "buildings",
                "cluster",
                "fortifications",
                "siege_towers",
                "units",
                "walls"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "buildings",
                  "cluster",
                  "fortifications",
                  "siege_towers",
                  "units",
                  "walls"
                ]
              },
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true
            }
          ]
        }
      },
      "dependentRequired": {
        "interval_moving": [
          "interval"
        ],
        "interval_standing": [
          "interval"
        ],
        "attached_interval": [
          "interval"
        ],
        "stagger_max": [
          "interval"
        ],
        "stagger_min": [
          "stagger_max"
        ]
      },
      "allOf": [
        {
          "not": {
            "required": [
              "spread",
              "spread_tiles"
            ]
          }
        },
        {
          "not": {
            "required": [
              "inaccuracy",
              "inaccuracy_tiles"
            ]
          }
        }
      ]
    }
  }
